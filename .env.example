# ============================================
# Dev Academy - local environment
# NEVER commit real values. This file is only an example.
# Copy it to .env and fill in the secrets.
# ============================================

# --- Base44 (used only for the one-time data export) ---
BASE44_APP_ID=
BASE44_PAT=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Browser-safe key (sb_publishable_... or legacy anon JWT)
SUPABASE_ANON_KEY=
SUPABASE_LEGACY_ANON_KEY=
# Server-only key. Bypasses RLS. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Management API token (scoped). Used by local scripts (migrations, imports).
SUPABASE_ACCESS_TOKEN=
# Postgres password of the project database.
SUPABASE_DB_PASSWORD=
# Optional direct/session-pooler override for backups (Supabase dashboard → Connect).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_USER=
# Supabase Auth Turnstile secret (server-side only).
TURNSTILE_SECRET_KEY=

# --- Dev seed script (scripts/seed-test-user.mjs) ---
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Hugging Face (media hosting) ---
HF_USER=
HF_TOKEN=
HF_REPO=
HF_PUBLIC_BASE=

# --- Cloudflare (Pages deploy + analytics) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Email delivery through Pages Functions ---
# EMAIL_PROVIDER=gmail | brevo | resend
# gmail is the default path: 500 recipients/day on a free Gmail account and
# no custom domain required. Create a Desktop OAuth client in Google Cloud,
# enable the Gmail API, and request the gmail.send scope.
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional fallbacks.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Dev Academy <islam230366qw@gmail.com>
SITE_URL=https://dev-academy.pages.dev

# --- Encrypted off-site backup (scripts/backup-offsite.mjs) ---
BACKUP_ARCHIVE_PASSWORD=
ONEDRIVE_BACKUP_DIR=
BACKUP_MEDIA_CONCURRENCY=
PG_DUMP_BIN=
SEVEN_ZIP_BIN=
