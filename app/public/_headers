/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.googleusercontent.com https://huggingface.co https://*.hf.co; media-src 'self' blob: https://*.supabase.co https://huggingface.co https://*.hf.co; connect-src 'self' blob: https://*.supabase.co wss://*.supabase.co https://huggingface.co https://*.hf.co https://dev-academy-hf-upload.restaurant-system-api.workers.dev https://cloudflareinsights.com https://www.googleapis.com; frame-src 'self' https://challenges.cloudflare.com https://drive.google.com https://docs.google.com https://*.supabase.co https://huggingface.co https://*.hf.co https://www.youtube-nocookie.com https://www.youtube.com https://view.officeapps.live.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=3600

/favicon.png
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo-mark.png
  Cache-Control: public, max-age=604800

/logo-mark.webp
  Cache-Control: public, max-age=604800

/logo-full.jpg
  Cache-Control: public, max-age=604800
