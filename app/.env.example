# Copy to .env and fill with real values (never commit .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: enables Cloudflare Turnstile CAPTCHA on the legacy break-glass page.
# Public Google login does not use Turnstile. Leave empty/absent to disable the widget.
VITE_TURNSTILE_SITE_KEY=
# Disabled in production; /legacy-login redirects to /login.
# Re-enable only together with a deliberate Supabase Email-provider rollback.
VITE_ENABLE_LEGACY_LOGIN=false
# Serverless upload Worker that hides Hugging Face S3 credentials.
VITE_HF_UPLOAD_WORKER_URL=https://your-worker.your-subdomain.workers.dev
