# Copy to .env and fill with real values (never commit .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: enables Cloudflare Turnstile CAPTCHA on the login page.
# Leave empty/absent to disable the widget (safe default).
VITE_TURNSTILE_SITE_KEY=
# Serverless upload Worker that hides Hugging Face S3 credentials.
VITE_HF_UPLOAD_WORKER_URL=https://your-worker.your-subdomain.workers.dev
